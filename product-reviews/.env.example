# Copy to .env.local and replace with your Merchant Center values.
# .env.local is gitignored.

# Region of your Merchant Center (gcp-eu, gcp-us, aws-eu, aws-us, …)
CLOUD_IDENTIFIER=gcp-eu

# Project key you can log into during local development
CTP_INITIAL_PROJECT_KEY=your-project-key

# Must match the Custom Application entry point URI path
ENTRY_POINT_URI_PATH=hh-product-reviews

# Provided by Connect on deploy. Not needed for local start.
# CUSTOM_APPLICATION_ID=
# APPLICATION_URL=
